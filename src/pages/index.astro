---
import Layout from '../layouts/Layout.astro';
import MapArt from '../components/MapArt.astro';
import site from '../data/site.json';
import { url } from '../lib/paths';
const words = site.headline.trim().split(/\s+/);
const lastWord = words.pop();
---
<Layout title="Home"><section class="hero"><div class="hero-copy"><p class="eyebrow">{site.name} / {site.role}</p><h1>{words.join(' ')}<br/><em>{lastWord}</em></h1><p class="lead">{site.intro}</p><div class="actions"><a class="button" href={url('projects/')}>Explore the work <span>↗</span></a><a class="text-link" href={url('about/')}>A little about me →</a></div><p class="edition"><span></span> Portfolio in progress · Version 01</p></div><div class="hero-map"><MapArt/><span class="map-side">A DIFFERENT PERSPECTIVE ON THE EVERYDAY</span></div></section><section class="intro-strip"><p class="eyebrow">THE PRACTICE</p><p>From geographic data<br/>to a clearer <em>perspective.</em></p><p>{site.approach}</p></section><section class="section"><div class="section-heading"><div><p class="eyebrow">EXPLORE THE PORTFOLIO</p><h2>Work, mapped out.</h2></div><span class="muted">Sample content · ready to replace</span></div><div class="explore-grid">{[['01','Completed Projects','Case-study outlines for future real-world work.','projects/'],['02','Ongoing Work','A place to document questions, methods, and progress.','ongoing/'],['03','Map Gallery','Visual studies with briefs and technical notes.','gallery/']].map(([n,title,body,path])=><a class="explore" href={url(path)}><span class="eyebrow">{n} / COLLECTION</span><h3>{title} <span>↗</span></h3><p>{body}</p></a>)}</div></section><aside class="notice">All projects and maps in this first edition are clearly marked placeholders. They do not represent completed work or verified findings.</aside></Layout>